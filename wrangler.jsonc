{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plaintextprivacy",
  // set this to today's date and update when you make breaking changes
  "compatibility_date": "2026-05-05",
  "assets": {
    // serve index.html for any path that doesn't match a static asset
    // required for React SPA client-side routing to work correctly
    "not_found_handling": "single-page-application"
  }
}
